import java.util.*;

public class Main {

    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();

        int[] arr = new int[n];

        for (int i = 0; i < n; i++) {
            arr[i] = sc.nextInt();
        }

        int T = sc.nextInt();

        HashSet<Integer> set = new HashSet<>();

        boolean found = false;

        for (int num : arr) {

            int complement = T - num;

            if (set.contains(complement)) {
                System.out.println(
                    "Pair found: " + complement + " + " + num
                );
                found = true;
                break;
            }

            set.add(num);
        }

        if (!found) {
            System.out.println("No pair found");
        }
    }
}
