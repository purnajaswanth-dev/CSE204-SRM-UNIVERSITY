import java.util.*;

public class Main {

    static class Node {
        int data;
        Node next;

        Node(int data) {
            this.data = data;
        }
    }

    static class Queue {
        Node front;
        Node rear;

        void enqueue(int data) {

            Node newNode = new Node(data);

            if (rear == null) {
                front = rear = newNode;
                return;
            }

            rear.next = newNode;
            rear = newNode;
        }

        int dequeue() {

            if (front == null) {
                System.out.println("Queue Underflow");
                return -1;
            }

            int value = front.data;

            front = front.next;

            if (front == null)
                rear = null;

            return value;
        }

        int peek() {

            if (front == null) {
                System.out.println("Queue is empty");
                return -1;
            }

            return front.data;
        }

        void display() {

            if (front == null) {
                System.out.println("Queue is empty");
                return;
            }

            Node current = front;

            while (current != null) {
                System.out.print(current.data + " ");
                current = current.next;
            }

            System.out.println();
        }
    }

    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        Queue queue = new Queue();

        int n = sc.nextInt();

        for (int i = 0; i < n; i++) {
            queue.enqueue(sc.nextInt());
        }

        System.out.println("Queue:");
        queue.display();

        System.out.println("Front element: " + queue.peek());

        System.out.println("Dequeued: " + queue.dequeue());

        System.out.println("Queue after dequeue:");
        queue.display();
    }
}
